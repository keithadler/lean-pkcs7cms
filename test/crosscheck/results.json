{
 "cases": [
  {
   "id": "valid-attached",
   "what": "control: signed attributes, content inside",
   "lean_expected": true,
   "msg": "valid-attached.der"
  },
  {
   "id": "valid-detached",
   "what": "control: detached signature, content given separately",
   "lean_expected": true,
   "msg": "valid-detached.der",
   "content": "valid-detached.content"
  },
  {
   "id": "valid-noattrs",
   "what": "control: no signed attributes, signature over the content",
   "lean_expected": true,
   "msg": "valid-noattrs.der"
  },
  {
   "id": "valid-ski",
   "what": "control: signer named by subject key identifier (SignerInfo v3, SignedData v3)",
   "lean_expected": true,
   "msg": "valid-ski.der"
  },
  {
   "id": "valid-sha256rsa",
   "what": "control: signatureAlgorithm sha256WithRSAEncryption",
   "lean_expected": true,
   "msg": "valid-sha256rsa.der"
  },
  {
   "id": "valid-digest-null",
   "what": "control: digestAlgorithm SHA-256 with NULL parameters (RFC 5754 asks verifiers to accept)",
   "lean_expected": true,
   "msg": "valid-digest-null.der"
  },
  {
   "id": "attrs-unsorted-signed-as-written",
   "what": "signed attributes not in DER order, signature over the bytes as written",
   "lean_expected": false,
   "msg": "attrs-unsorted-signed-as-written.der"
  },
  {
   "id": "attrs-unsorted-signed-sorted",
   "what": "signed attributes not in DER order, signature over their DER (sorted) encoding",
   "lean_expected": false,
   "msg": "attrs-unsorted-signed-sorted.der"
  },
  {
   "id": "sig-over-a0",
   "what": "signature over the attributes with the [0] tag 0xA0, not the SET OF tag 0x31",
   "lean_expected": false,
   "msg": "sig-over-a0.der"
  },
  {
   "id": "sig-over-content-with-attrs",
   "what": "signed attributes present, but the signature is over the content",
   "lean_expected": false,
   "msg": "sig-over-content-with-attrs.der"
  },
  {
   "id": "md-twice-first-right",
   "what": "two message-digest attributes, the first one right",
   "lean_expected": false,
   "msg": "md-twice-first-right.der"
  },
  {
   "id": "md-twice-second-right",
   "what": "two message-digest attributes, the second one right",
   "lean_expected": false,
   "msg": "md-twice-second-right.der"
  },
  {
   "id": "md-two-values",
   "what": "one message-digest attribute with two values",
   "lean_expected": false,
   "msg": "md-two-values.der"
  },
  {
   "id": "md-missing",
   "what": "no message-digest attribute",
   "lean_expected": false,
   "msg": "md-missing.der"
  },
  {
   "id": "md-wrong",
   "what": "message-digest of other content",
   "lean_expected": false,
   "msg": "md-wrong.der"
  },
  {
   "id": "ct-missing",
   "what": "no content-type attribute",
   "lean_expected": false,
   "msg": "ct-missing.der"
  },
  {
   "id": "ct-twice",
   "what": "two content-type attributes",
   "lean_expected": false,
   "msg": "ct-twice.der"
  },
  {
   "id": "ct-mismatch",
   "what": "content-type attribute says TSTInfo, the content is id-data",
   "lean_expected": false,
   "msg": "ct-mismatch.der"
  },
  {
   "id": "relabeled-after-signing",
   "what": "signed normally, then eContentType changed from id-data to 1.2.840.113549.1.7.5, with no key",
   "lean_expected": false,
   "msg": "relabeled-after-signing.der"
  },
  {
   "id": "ct-mismatch-tst",
   "what": "content-type attribute says id-data, the content is TSTInfo",
   "lean_expected": false,
   "msg": "ct-mismatch-tst.der"
  },
  {
   "id": "md-two-documents",
   "what": "detached: message-digests of two different documents, checked against the second",
   "lean_expected": false,
   "msg": "md-two-documents.der",
   "content": "md-two-documents.content"
  },
  {
   "id": "noattrs-not-data",
   "what": "no signed attributes, and the content type is not id-data",
   "lean_expected": false,
   "msg": "noattrs-not-data.der"
  },
  {
   "id": "time-twice",
   "what": "two signing-time attributes",
   "lean_expected": false,
   "msg": "time-twice.der"
  },
  {
   "id": "time-invalid",
   "what": "signing-time 2026-02-30",
   "lean_expected": false,
   "msg": "time-invalid.der"
  },
  {
   "id": "countersig-signed",
   "what": "a countersignature among the signed attributes",
   "lean_expected": false,
   "msg": "countersig-signed.der"
  },
  {
   "id": "si-version-3-issuer",
   "what": "SignerInfo version 3 with issuerAndSerialNumber (must be 1)",
   "lean_expected": false,
   "msg": "si-version-3-issuer.der"
  },
  {
   "id": "sd-version-3",
   "what": "SignedData version 3 for plain data and v1 signers (must be 1)",
   "lean_expected": false,
   "msg": "sd-version-3.der"
  },
  {
   "id": "sig-short",
   "what": "RSA signature one byte shorter than the modulus (its leading zero dropped)",
   "lean_expected": false,
   "msg": "sig-short.der"
  },
  {
   "id": "sig-full-length",
   "what": "control: the same signature with its leading zero kept",
   "lean_expected": true,
   "msg": "sig-full-length.der"
  },
  {
   "id": "trailing-byte",
   "what": "a zero byte after the message",
   "lean_expected": false,
   "msg": "trailing-byte.der"
  },
  {
   "id": "ber-indefinite",
   "what": "BER indefinite lengths on the outer ContentInfo (legal CMS, not DER)",
   "lean_expected": false,
   "msg": "ber-indefinite.der"
  },
  {
   "id": "no-signers",
   "what": "SignedData with no SignerInfo at all",
   "lean_expected": false,
   "msg": "no-signers.der"
  },
  {
   "id": "no-cert",
   "what": "the signer's certificate is not in the message",
   "lean_expected": false,
   "msg": "no-cert.der"
  }
 ],
