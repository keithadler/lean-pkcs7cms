 "theorems":
 [["signerOk_iff",
   "The checker accepts a signer exactly when the specification SignerValid holds."],
  ["signed_attrs_slice",
   "The signed bytes are the message's own bytes, with the tag 0xA0 changed to 0x31."],
  ["reencode_same",
   "Sorting the signed attributes changes nothing, so no two verifiers can disagree."],
  ["digest_signed", "The content's SHA-256 is inside the signed bytes."],
  ["verify_iff",
   "RSA accepts exactly when sᵉ mod n is the one correctly padded block (lean-x509)."],
  ["decode_der",
   "The message is DER: one encoding, nothing before or after it."],
  ["verifyStamp_sound", "What the token says is the TSTInfo that was signed."],
  ["findings_stamped",
   "This token verifies, and dates the findings' SHA-256 to 2026-09-28 22:03:34 UTC."]],
